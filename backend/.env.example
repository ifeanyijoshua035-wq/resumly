# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
APP_URL=http://localhost:4000

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Flutterwave (https://dashboard.flutterwave.com/settings/apis)
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# A secret string YOU make up and paste into your Flutterwave dashboard under
# Settings -> Webhooks ("Secret hash" field). Flutterwave echoes it back on
# every webhook call so the server can confirm the request really came from
# them. It must match exactly in both places.
FLW_SECRET_HASH=replace_with_another_long_random_string

# Premium pricing by region lives in src/utils/pricing.js, not here, since it's
# three tiers (Nigeria / rest of Africa / outside Africa), not one number.
# Edit that file to change prices or currencies.
